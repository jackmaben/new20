# Netlify / Cloudflare Pages equivalent of .htaccess caching rules.
# Ignore this file if you host on Apache/cPanel — .htaccess covers it.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: public, max-age=600, s-maxage=3600, stale-while-revalidate=86400, stale-if-error=604800
  Vary: Accept-Encoding
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/
  Cache-Control: public, max-age=600, s-maxage=3600, stale-while-revalidate=86400, stale-if-error=604800

/sitemap.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600
